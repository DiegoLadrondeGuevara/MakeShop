AWS_REGION=us-east-1

# AWS Academy / Learner Lab credentials.
# If AWS_ACCESS_KEY_ID starts with ASIA, AWS_SESSION_TOKEN is required.
AWS_ACCESS_KEY_ID=ASIA_CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_SESSION_TOKEN=CHANGE_ME

# Optional. SETUP.sh auto-detects one VPC and two subnets if this is empty.
VPC_ID=
OPENSTORE_KEY_NAME=

# GitHub repository connected to Amplify.
FRONTEND_REPO_URL=https://github.com/Lazheart/MakeShop.git
FRONTEND_BRANCH_NAME=main
FRONTEND_AMPLIFY_APP_NAME=makeshop-frontend
FRONTEND_AMPLIFY_ACCESS_TOKEN=ghp_CHANGE_ME

# Docker images pulled by backend/docker-compose.yml on the EC2 app servers.
DOCKER_IMAGE_NAMESPACE=diegoladrondeguevara
DOCKER_IMAGE_TAG=latest
ATHENA_WORKGROUP=openstore-workgroup

# EC2 sizing. AWS Academy may have limited quota; t3.small is safer than t3.medium.
INSTANCE_TYPE=t3.small
DB_INSTANCE_TYPE=t3.small
