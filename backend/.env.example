# MakeShop backend runtime
#
# Local: use DB_HOST=host.docker.internal if databases run from database/docker-compose.yml.
# AWS: CloudFormation writes DB_HOST with the private IP of the DB EC2 instance.

DOCKER_IMAGE_NAMESPACE=diegoladrondeguevara
DOCKER_IMAGE_TAG=latest

DB_HOST=host.docker.internal

# User Service (PostgreSQL)
POSTGRES_DB=userdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
DATABASE_URL=jdbc:postgresql://host.docker.internal:5432/userdb
DB_USERNAME=admin
DB_PASSWORD=admin123
DB_NAME=userdb
JPA_DDL_AUTO=update
APP_BASE_URL=http://localhost:8004

# JWT. Replace in production with a long random secret.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=86400000

# Shop Service (MySQL)
MYSQL_ROOT_PASSWORD=admin123
MYSQL_DATABASE=shopdb
MYSQL_USER=admin
MYSQL_PASSWORD=admin123
SHOP_DB_USERNAME=admin
SHOP_DB_PASSWORD=admin123

# Product Service (MongoDB)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin123
MONGO_INITDB_DATABASE=productdb

# AWS/S3
AWS_REGION=us-east-1
BUCKET_NAME=makeshop-products-CHANGE_ME_ACCOUNT_ID

# Store Service analytics
ATHENA_DATABASE=openstore_catalog
ATHENA_RESULTS_BUCKET=s3://openstore-ingest-CHANGE_ME_ACCOUNT_ID/athena-results/
ATHENA_WORKGROUP=openstore-workgroup
ATHENA_TIMEOUT_SECONDS=90
